{
  "name": "crm-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CRM Admin Dashboard REST API (Express + Mongoose)",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
